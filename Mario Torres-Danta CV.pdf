	% --- RESEARCH EXPERIENCE ---
	\section*{Research Experience}
	
	\begin{itemize}
		\entry{Visiting Student \& Undergraduate Researcher}{Aug 2026 -- Sep 2026}
		\item[] \textit{University of Copenhagen, Denmark}
		\item[] \textbf{Project:} Research project on mapping class groups of surfaces, Teichmüller theory and Riemann moduli spaces, including braid groups and homological stability. Resulted in a manuscript in preparation (see below).
		\item[] \textbf{Supervisor:} Prof. Nathalie Wahl
	\end{itemize}
	
	\entrysep
	
	\begin{itemize}
		\entry{FUSRP Undergraduate Researcher}{Jun 2026 -- Jul 2026}
		\item[] \textit{The Fields Institute for Research in Mathematical Sciences, Toronto, Canada}
		\item[] \textbf{Project:} Laurent symmetric functions and their relation with the representation theory of general linear groups. Resulted in a preprint (see below).
		\item[] \textbf{Supervisors:} Prof. Alistair Savage and Dr. Yaolong Shen
	\end{itemize}
	
	\entrysep
	
	\begin{itemize}
		\entry{Undergraduate Researcher (Departmental Collaborator)}{Sep 2025 -- Jun 2026}
		\item[] \textit{Department of Geometry and Topology, University of Seville}
		\item[] \textbf{Project:} Advanced topics in Topology and Group Theory. A guided study complementing the standard undergraduate curriculum.
		\item[] \textbf{Supervisor:} Prof. Ramón J. Flores
	\end{itemize}
	
	\entrysep
	
	\begin{itemize}
		\entry{Undergraduate Researcher (Departmental Collaborator)}{Sep 2024 -- Jun 2025}
		\item[] \textit{Department of Algebra, University of Seville}
		\item[] \textbf{Project:} Classification of homographies and homologies in real ($\mathbb{P}^n(\mathbb{R})$) and complex ($\mathbb{P}^n(\mathbb{C})$) projective spaces.
		\item[] \textbf{Supervisor:} Prof. Francisco Castro Jiménez
	\end{itemize}
	
